%%{init: {"theme": "base", "themeVariables": {"background": "#0a0e1a", "primaryColor": "#0d1f35", "primaryBorderColor": "#00d4ff", "primaryTextColor": "#caf0f8", "secondaryColor": "#06111f", "tertiaryColor": "#081828", "lineColor": "#00b4d8", "clusterBkg": "#060c18", "clusterBorder": "#1565c0", "titleColor": "#00e5ff", "edgeLabelBackground": "#0a1628", "fontFamily": "monospace", "fontSize": "14px"}}}%%
flowchart TD

    START(["`NRL 服务器启动`"]):::startNode
    START --> FORK["同时启动双机制"]:::forkNode

    FORK --> APRS_IN
    FORK --> WEB_IN

    subgraph APRS_FLOW["APRS 主要机制"]
        APRS_IN{APRS 配置完整?}:::decNode
        APRS_IN -- 否 --> ASKIP(["跳过 APRS"]):::skipNode
        APRS_IN -- 是 --> ACONN["`连接 APRS-IS
TCP 认证`"]:::aprsNode
        ACONN --> AREP["`上报位置包 + 状态包
目的地: NRLSRV`"]:::aprsNode
        AREP --> AMAP["aprs.tv 收录  全球地图可见"]:::aprsNode
        ACONN --> ATIMER["`每 60 秒查询 aprs.tv
/api/findnrl
?dest=NRLSRV`"]:::aprsNode
        ATIMER --> ALIST["获取活跃 NRL 服务器列表"]:::aprsNode
    end

    subgraph WEB_FLOW["nrlptt.com 备用机制"]
        WEB_IN{SelfAddress/Port 已配置?}:::decNode
        WEB_IN -- 否 --> WSKIP(["跳过官网同步"]):::skipNode
        WEB_IN -- 是 --> WBOOT["启动时立即执行"]:::webNode
        WBOOT --> WREP["`POST nrlptt.com
/api/platform-servers/
report  上报状态`"]:::webNode
        WBOOT --> WGET["`GET nrlptt.com
/api/platform-servers
获取全网服务器列表`"]:::webNode
        WREP2["`每 3 分钟`"]:::timerNode --> WREP
        WGET2["`每 5 分钟`"]:::timerNode --> WGET
        WBOOT --> WREP2
        WBOOT --> WGET2
    end

    ALIST --> MERGE["`合并更新 PlatformList
解析 UDP 地址 / 过滤自身`"]:::mergeNode
    WGET --> MERGE

    MERGE --> FWD["`999 房间语音
自动转发至所有互联服务器`"]:::fwdNode

    classDef startNode fill:#0a2d5a,stroke:#00e5ff,stroke-width:3px,color:#00e5ff
    classDef forkNode fill:#1a0d35,stroke:#7c3aed,stroke-width:2px,color:#c4b5fd
    classDef decNode fill:#0d1f35,stroke:#38bdf8,stroke-width:2px,color:#7dd3fc
    classDef skipNode fill:#1a1a1a,stroke:#334155,stroke-width:1px,color:#64748b
    classDef aprsNode fill:#1a0d35,stroke:#7c3aed,stroke-width:2px,color:#c4b5fd
    classDef webNode fill:#0d2d1a,stroke:#4ade80,stroke-width:2px,color:#bbf7d0
    classDef timerNode fill:#0d1f35,stroke:#fb923c,stroke-width:1px,color:#fed7aa
    classDef mergeNode fill:#0d2d5e,stroke:#00d4ff,stroke-width:2px,color:#caf0f8
    classDef fwdNode fill:#0a2d5a,stroke:#00e5ff,stroke-width:3px,color:#00e5ff
