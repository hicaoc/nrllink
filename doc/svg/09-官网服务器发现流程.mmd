%%{init: {"theme": "base", "themeVariables": {"background": "#0a0e1a", "primaryColor": "#0d1f35", "primaryBorderColor": "#00d4ff", "primaryTextColor": "#caf0f8", "secondaryColor": "#06111f", "tertiaryColor": "#081828", "lineColor": "#00b4d8", "clusterBkg": "#060c18", "clusterBorder": "#1565c0", "titleColor": "#00e5ff", "edgeLabelBackground": "#0a1628", "fontFamily": "monospace", "fontSize": "14px"}}}%%
flowchart TD

    START(["`NRL 服务器启动`"]):::startNode
    START --> CHK{"`SelfAddress
SelfPort
已配置?`"}:::decNode

    CHK -- 否 --> SKIP(["⏭  跳过，不参与官网互联"]):::skipNode

    CHK -- 是 --> BOOT["立即执行首次上报 + 同步"]:::activeNode

    BOOT --> REP["`POST nrlptt.com
/api/platform-servers
/report`"]:::repNode
    BOOT --> GET["`GET nrlptt.com
/api/platform-servers`"]:::getNode

    REP --> RPAY["`上报内容
name  :  平台名称
host  :  公网 IP
port  :  60050
online:  当前在线数
total :  历史峰值`"]:::payNode

    GET --> PARSE["`解析服务器列表
过滤自身 SelfAddress
解析 UDP 地址`"]:::parseNode

    PARSE --> UPDATE["`更新 PlatformList
全局互联列表`"]:::updateNode

    UPDATE --> FWD["`999 房间语音
转发至所有互联服务器`"]:::fwdNode

    BOOT --> T1["`每 3 分钟`"]:::timerNode
    BOOT --> T2["`每 5 分钟`"]:::timerNode
    T1 --> REP
    T2 --> GET

    classDef startNode fill:#0a2d5a,stroke:#00e5ff,stroke-width:3px,color:#00e5ff
    classDef decNode fill:#0d1f35,stroke:#38bdf8,stroke-width:2px,color:#7dd3fc
    classDef skipNode fill:#1a1a1a,stroke:#334155,stroke-width:1px,color:#64748b
    classDef activeNode fill:#0d2d1a,stroke:#4ade80,stroke-width:2px,color:#bbf7d0
    classDef repNode fill:#0d2d1a,stroke:#4ade80,stroke-width:2px,color:#bbf7d0
    classDef getNode fill:#0d2d1a,stroke:#4ade80,stroke-width:2px,color:#bbf7d0
    classDef payNode fill:#0d1f2d,stroke:#38bdf8,stroke-width:1px,color:#7dd3fc
    classDef parseNode fill:#0d2d5e,stroke:#00d4ff,stroke-width:2px,color:#caf0f8
    classDef updateNode fill:#0d2d5e,stroke:#00d4ff,stroke-width:2px,color:#caf0f8
    classDef fwdNode fill:#0a2d5a,stroke:#00e5ff,stroke-width:3px,color:#00e5ff
    classDef timerNode fill:#0d1f35,stroke:#fb923c,stroke-width:1px,color:#fed7aa
